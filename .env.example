# -----------------------------------------------------------------------------
# WorkSpace SaaS - Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env for local development:
#   cp .env.example .env
# Never commit actual credentials or secret values to version control.
# -----------------------------------------------------------------------------

# Backend API Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000

# Database Configuration (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://workspace_user:workspace_pass@localhost:5432/workspace_dev?schema=public
POSTGRES_USER=workspace_user
POSTGRES_PASSWORD=workspace_pass
POSTGRES_DB=workspace_dev
POSTGRES_PORT=5432

# Redis Cache & Queue Infrastructure
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
