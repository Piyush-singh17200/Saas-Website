# -----------------------------------------------------------------------------
# WorkSpace SaaS - Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env for local development:
#   cp .env.example .env
# Never commit actual credentials or secret values to version control.
# -----------------------------------------------------------------------------

# Backend API Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://workspace_user:workspace_pass@localhost:5432/workspace_dev?schema=public
TEST_DATABASE_URL=postgresql://workspace_user:workspace_pass@localhost:5432/workspace_test?schema=public
POSTGRES_USER=workspace_user
POSTGRES_PASSWORD=workspace_pass
POSTGRES_DB=workspace_dev
POSTGRES_PORT=5432

# Authentication & Session Security
SESSION_COOKIE_NAME=workspace_session
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000

# Redis Cache & Queue Infrastructure
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
USE_REDIS_MOCK=false

# API Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
TRUST_PROXY=false

# Background Worker & Email Provider (development-safe simulated email)
EMAIL_PROVIDER=development

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000

# Stripe & Billing Configuration (Test Mode)
# Obtain these from your Stripe Dashboard in Test Mode: https://dashboard.stripe.com/test
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_here
STRIPE_PRO_PRICE_ID=price_placeholder_pro_monthly

# Organization Entitlement Limits (Configurable Server-Side Defaults)
FREE_MAX_PROJECTS=3
FREE_MAX_MEMBERS=5
PRO_MAX_PROJECTS=50
PRO_MAX_MEMBERS=50

# Storage & Object Storage Configuration
# Options: 'local' (filesystem) or 's3' (AWS S3, MinIO, Cloudflare R2, etc.)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_BYTES=10485760
STORAGE_SIGNED_URL_EXPIRES_SECONDS=900

# S3-Compatible Storage (Required if STORAGE_PROVIDER=s3)
STORAGE_S3_BUCKET=workspace-attachments
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_ACCESS_KEY_ID=minioadmin
STORAGE_S3_SECRET_ACCESS_KEY=minioadmin
STORAGE_S3_FORCE_PATH_STYLE=true

# Enterprise Security & Account Protection (MFA AES-256-GCM Encryption Key)
# In production, must be a cryptographically secure 32-byte hex key (64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef


