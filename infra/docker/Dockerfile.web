# ==============================================================================
# Production Dockerfile: Next.js Frontend (@workspace/web)
# Multi-stage standalone build with non-root security context
# ==============================================================================

FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@12.10.1 --activate
WORKDIR /app

# ------------------------------------------------------------------------------
# 1. Dependency Resolution & Build Stage
# ------------------------------------------------------------------------------
FROM base AS builder

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/test-utils/package.json ./packages/test-utils/
COPY apps/web/package.json ./apps/web/

RUN pnpm install --frozen-lockfile --filter @workspace/web... --filter @workspace/contracts

COPY packages/config/ ./packages/config/
COPY packages/contracts/ ./packages/contracts/
COPY packages/test-utils/ ./packages/test-utils/
COPY apps/web/ ./apps/web/

# Set build-time public environment variables
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_OUTPUT_STANDALONE=true
ENV NODE_ENV=production

# Build contracts and standalone Next.js application
RUN pnpm --filter @workspace/contracts build && \
    pnpm --filter @workspace/web build

# ------------------------------------------------------------------------------
# 2. Production Runner Stage
# ------------------------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Install curl for container health check
RUN apk add --no-cache curl

# Security: Run as unprivileged node user (UID 1000)
USER node

# Copy standalone build artifacts
COPY --chown=node:node --from=builder /app/apps/web/.next/standalone ./
COPY --chown=node:node --from=builder /app/apps/web/.next/static ./apps/web/.next/static

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3000/ || exit 1

CMD ["node", "apps/web/server.js"]
